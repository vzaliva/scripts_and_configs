[user]
	email = lord@crocodile.org
	name = Vadim Zaliva
[color]
	ui = auto

[url "git@github.com:"]
	insteadOf = "https://github.com/"

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true

[pull]
	rebase = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[tag]
	sort = version:refname
[push]
	default = simple
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[rerere]
	enabled = true
	autoupdate = true
# No global credential helper: the one https remote that needs a saved
# token (ASTLean) sets `credential.helper = store` in its own .git/config.
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
